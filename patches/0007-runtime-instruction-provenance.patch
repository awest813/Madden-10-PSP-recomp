diff --git a/include/psprecomp/instruction_trace.hpp b/include/psprecomp/instruction_trace.hpp
new file mode 100644
--- /dev/null
+++ b/include/psprecomp/instruction_trace.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include <cstdint>
+
+namespace psprecomp {
+class Runtime;
+struct AllegrexContext;
+void reset_aot_instruction_trace() noexcept;
+using AotInstructionObserver = void (*)(const Runtime &, const AllegrexContext &,
+                                        std::uint32_t, std::uint32_t, bool);
+void set_aot_instruction_observer(AotInstructionObserver) noexcept;
+// Diagnostic AOT builds only. Called before an instruction changes registers
+// or accesses memory; ordinary generated code compiles these calls out.
+void trace_aot_instruction(Runtime &, const AllegrexContext &, std::uint32_t pc,
+                           std::uint32_t word, const char *host_function,
+                           bool delay_slot = false);
+void trace_aot_branch(Runtime &, const AllegrexContext &, std::uint32_t pc,
+                      std::uint32_t word, const char *host_function,
+                      std::uint32_t selected_target);
+}
diff --git a/src/instruction_trace.cpp b/src/instruction_trace.cpp
new file mode 100644
--- /dev/null
+++ b/src/instruction_trace.cpp
@@ -0,0 +1,155 @@
+#include "psprecomp/instruction_trace.hpp"
+#include "psprecomp/runtime.hpp"
+#include "psprecomp/common.hpp"
+#include "psprecomp/decoder.hpp"
+#include <algorithm>
+#include <array>
+#include <sstream>
+
+namespace psprecomp {
+namespace {
+struct History {
+    const Runtime *runtime{};
+    RuntimeExecutionContextToken owner{};
+    std::array<std::uint32_t, 16> pcs{};
+    struct Snapshot {
+        std::uint32_t word{};
+        std::array<std::uint32_t, 32> gpr{};
+        bool delay_slot{};
+    };
+    std::array<Snapshot, 16> snapshots{};
+    unsigned next{}, count{};
+    std::uint32_t branch_pc{}, branch_target{};
+};
+thread_local History history;
+thread_local AotInstructionObserver observer{};
+constexpr const char *register_names[] = {
+    "zero", "at", "v0", "v1", "a0", "a1", "a2", "a3",
+    "t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7",
+    "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
+    "t8", "t9", "k0", "k1", "gp", "sp", "fp", "ra"};
+std::string decoded_operation(std::uint32_t pc, std::uint32_t word) {
+    const auto d = decode_allegrex(word);
+    std::ostringstream out;
+    out << d.mnemonic;
+    const auto op = word >> 26u;
+    if (op >= 0x20u && op <= 0x2Eu) {
+        out << ' ' << register_names[d.rt] << ", " << d.immediate << '(' << register_names[d.rs] << ')';
+    } else if (d.kind == OpcodeKind::J || d.kind == OpcodeKind::Jal) {
+        out << ' ' << hex32(((pc + 4u) & 0xF0000000u) | (d.target << 2u));
+    } else if (d.kind == OpcodeKind::Jr || d.kind == OpcodeKind::Jalr) {
+        out << ' ' << register_names[d.rs];
+    } else if ((op >= 4u && op <= 7u) || (op >= 0x14u && op <= 0x17u)) {
+        out << ' ' << register_names[d.rs];
+        if (op == 4u || op == 5u || op == 0x14u || op == 0x15u) out << ", " << register_names[d.rt];
+        out << ", " << hex32(pc + 4u + static_cast<std::uint32_t>(static_cast<std::int32_t>(d.immediate) * 4));
+    } else if (d.kind == OpcodeKind::Lui) {
+        out << ' ' << register_names[d.rt] << ", " << hex32(word & 0xFFFFu);
+    } else if (op >= 8u && op <= 0xEu) {
+        out << ' ' << register_names[d.rt] << ", " << register_names[d.rs] << ", ";
+        if (op >= 0xCu) out << hex32(word & 0xFFFFu); else out << d.immediate;
+    } else if (op == 0u && ((word & 63u) == 0u || (word & 63u) == 2u || (word & 63u) == 3u)) {
+        if (d.kind != OpcodeKind::Nop)
+            out << ' ' << register_names[d.rd] << ", " << register_names[d.rt] << ", " << d.sa;
+    } else if (op == 0u && d.kind != OpcodeKind::Nop) {
+        out << ' ' << register_names[d.rd] << ", " << register_names[d.rs] << ", " << register_names[d.rt];
+    }
+    return out.str();
+}
+History &record(Runtime &rt, const AllegrexContext &ctx, std::uint32_t pc,
+                 std::uint32_t word, bool delay_slot) {
+    if (history.runtime != &rt || !runtime_execution_context_matches(history.owner)) {
+        history = {};
+        history.runtime = &rt;
+        history.owner = capture_runtime_execution_context();
+    }
+    history.pcs[history.next] = pc;
+    auto &snapshot = history.snapshots[history.next];
+    snapshot.word = word;
+    std::copy(std::begin(ctx.gpr), std::end(ctx.gpr), snapshot.gpr.begin());
+    snapshot.gpr[0] = 0u;
+    snapshot.delay_slot = delay_slot;
+    history.next = (history.next + 1u) % history.pcs.size();
+    history.count = std::min(history.count + 1u, unsigned(history.pcs.size()));
+    return history;
+}
+}
+
+void reset_aot_instruction_trace() noexcept { history = {}; }
+void set_aot_instruction_observer(AotInstructionObserver value) noexcept { observer = value; }
+
+void trace_aot_instruction(Runtime &rt, const AllegrexContext &ctx, std::uint32_t pc,
+                           std::uint32_t word, const char *host_function, bool delay_slot) {
+    auto &h = record(rt, ctx, pc, word, delay_slot);
+    if (observer) observer(rt, ctx, pc, word, delay_slot);
+    // Scalar integer/FPU loads/stores. Partial-word instructions access their
+    // aligned backing word. VFPU transfers retain their existing validation.
+    const auto op = word >> 26u;
+    unsigned width = 0;
+    bool store = false, partial = false;
+    switch (op) {
+    case 0x20: case 0x24: width = 1; break;
+    case 0x21: case 0x25: width = 2; break;
+    case 0x23: case 0x31: width = 4; break;
+    case 0x22: case 0x26: width = 4; partial = true; break;
+    case 0x28: width = 1; store = true; break;
+    case 0x29: width = 2; store = true; break;
+    case 0x2B: case 0x39: width = 4; store = true; break;
+    case 0x2A: case 0x2E: width = 4; store = partial = true; break;
+    default: return;
+    }
+    const auto base_register = (word >> 21u) & 31u;
+    const auto base = base_register ? ctx.gpr[base_register] : 0u;
+    const auto offset = static_cast<std::int32_t>(static_cast<std::int16_t>(word & 0xFFFFu));
+    const auto effective = base + static_cast<std::uint32_t>(offset);
+    const auto accessed = partial ? effective & ~3u : effective;
+    if (rt.memory().contains(accessed, width)) return;
+
+    std::ostringstream message;
+    message << "FAULT instruction_pc=" << hex32(pc) << " instruction_word=" << hex32(word)
+            << " operation=" << (store ? "STORE" : "LOAD") << " access_width=" << width
+            << " base_register=r" << base_register << " base_value=" << hex32(base)
+            << " signed_offset=" << offset << " effective_address=" << hex32(effective)
+            << " accessed_address=" << hex32(accessed)
+            << " in_delay_slot=" << delay_slot
+            << " previous_branch_pc=" << hex32(h.branch_pc)
+            << " previous_branch_target=" << hex32(h.branch_target)
+            << " guest_dispatch_entry=" << hex32(ctx.pc)
+            << " active_host_function=" << host_function
+            << " thread=" << runtime_thread_name()
+            << "\n  pre-access-gpr:";
+    for (unsigned i = 0; i < 32u; ++i)
+        message << " r" << i << '=' << hex32(i ? ctx.gpr[i] : 0u);
+    message << "\n  last_16_instrumented_guest_pcs (oldest first):";
+    for (unsigned i = 0; i < h.count; ++i)
+        message << ' ' << hex32(h.pcs[(h.next + h.pcs.size() - h.count + i) % h.pcs.size()]);
+    message << "\n  instruction_trace (execution order; deltas to next observed PC may include uninstrumented calls):";
+    for (unsigned i = 0; i < h.count; ++i) {
+        const auto index = (h.next + h.pcs.size() - h.count + i) % h.pcs.size();
+        const auto &s = h.snapshots[index];
+        message << "\n  [instruction] pc=" << hex32(h.pcs[index]) << " word=" << hex32(s.word)
+                << " decoded=\"" << decoded_operation(h.pcs[index], s.word) << "\""
+                << " delay=" << s.delay_slot << " before: a0=" << hex32(s.gpr[4]) << " a1=" << hex32(s.gpr[5])
+                << " s1=" << hex32(s.gpr[17]) << " sp=" << hex32(s.gpr[29]);
+        if (i + 1u < h.count) {
+            const auto &next = h.snapshots[(index + 1u) % h.pcs.size()];
+            message << " changes-at-next-observed-pc=" << hex32(h.pcs[(index + 1u) % h.pcs.size()]) << ':';
+            for (unsigned r = 1; r < 32u; ++r)
+                if (s.gpr[r] != next.gpr[r])
+                    message << " r" << r << ':' << hex32(s.gpr[r]) << "->" << hex32(next.gpr[r]);
+        } else {
+            message << " effective-address=" << hex32(effective) << " width=" << width << " result=FAULT-no-write";
+        }
+    }
+    // Fail before the invalid access. No write, zero-page mapping, return-value
+    // substitution or exception recovery takes place here.
+    throw Error(message.str());
+}
+
+void trace_aot_branch(Runtime &rt, const AllegrexContext &ctx, std::uint32_t pc,
+                      std::uint32_t word, const char *host_function, std::uint32_t selected_target) {
+    trace_aot_instruction(rt, ctx, pc, word, host_function);
+    history.branch_pc = pc;
+    history.branch_target = selected_target;
+}
+}
